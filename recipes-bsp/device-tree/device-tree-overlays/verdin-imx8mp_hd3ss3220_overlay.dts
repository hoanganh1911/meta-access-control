/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/usb/pd.h>

/ {
    compatible = "toradex,verdin-imx8mp";

    fragment@0 {
        target = <&i2c4>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;

            typec@47 {
                compatible = "ti,hd3ss3220";
                reg = <0x47>;
                status = "okay";

                connector {
                    compatible = "usb-c-connector";
                    label = "USB-C-SS";
                    data-role = "dual";
                    power-role = "dual";
                    try-power-role = "sink";
                    
                    /* Link to the USB controller */
                    port {
                        usb_con_endpoint: endpoint {
                            remote-endpoint = <&dwc3_0_endpoint>;
                        };
                    };
                };
            };
        };
    };

    /* Cấu hình trực tiếp vào node dwc3 bên trong usb3_1 */
    fragment@1 {
        target = <&usb3_1>;
        __overlay__ {
            status = "okay";
        };
    };

    fragment@2 {
        target-path = "/soc@0/usb@32f10108/usb@38200000";
        __overlay__ {
            status = "okay";
            dr_mode = "otg";
            usb-role-switch;
            role-switch-default-mode = "none";

            port {
                dwc3_0_endpoint: endpoint {
                    remote-endpoint = <&usb_con_endpoint>;
                };
            };
        };
    };
};
