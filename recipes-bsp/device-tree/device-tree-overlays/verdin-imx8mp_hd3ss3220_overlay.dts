/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/usb/pd.h>

/ {
    compatible = "toradex,verdin-imx8mp";

    /* 
     * Cấu hình lại regulator có sẵn của Verdin để điều khiển SODIMM 185 (USB_2_EN)
     * Schematic cho thấy U8 là AP2151 (Active-High). 
     */
    fragment@0 {

        target = <&reg_usb2_vbus>;
        __overlay__ {
            status = "okay";
            gpio = <&gpio1 0 GPIO_ACTIVE_HIGH>;
            enable-active-high;
            regulator-min-microvolt = <5000000>;
            regulator-max-microvolt = <5000000>;
        };
    };

    fragment@1 {
        target = <&i2c4>;
        __overlay__ {
            status = "okay";

            typec@47 {
                compatible = "ti,hd3ss3220";
                reg = <0x47>;
                status = "okay";

                connector {
                    compatible = "usb-c-connector";
                    label = "USB-C-SS";
                    data-role = "dual";
                    power-role = "dual";
                    try-power-role = "sink";
                    vbus-supply = <&reg_usb2_vbus>;

                    ports {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        port@0 {
                            reg = <0>;
                            usb_con_endpoint: endpoint {
                                remote-endpoint = <&usb3_1_endpoint>;
                            };
                        };
                    };
                };
            };
        };
    };

    fragment@2 {
        target = <&usb3_1>;
        __overlay__ {
            status = "okay";
            usb-role-switch;
            port {
                usb3_1_endpoint: endpoint {
                    remote-endpoint = <&usb_con_endpoint>;
                };
            };
        };
    };

    fragment@3 {
        target = <&usb_dwc3_1>;
        __overlay__ {
            dr_mode = "otg";
            usb-role-switch;
            /* Cần gán vbus cho cả controller để nó biết khi nào có nguồn */
            vbus-supply = <&reg_usb2_vbus>;
        };
    };
};

