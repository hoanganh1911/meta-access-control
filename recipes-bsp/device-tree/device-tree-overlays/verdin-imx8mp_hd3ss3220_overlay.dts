/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/usb/pd.h>

/ {
    compatible = "toradex,verdin-imx8mp";

    fragment@0 {
        target = <&i2c4>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;

            typec@47 {
                compatible = "ti,hd3ss3220";
                reg = <0x47>;
                status = "okay";
                /* Khai báo nó là một role switch */
                usb-role-switch;

                connector {
                    compatible = "usb-c-connector";
                    label = "USB-C-SS";
                    data-role = "dual";
                    power-role = "dual";
                    try-power-role = "sink";
                    
                    ports {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        port@0 {
                            reg = <0>;
                            usb_con_endpoint: endpoint {
                                remote-endpoint = <&dwc3_0_endpoint>;
                            };
                        };
                    };
                };
            };
        };
    };

    /* Cấu hình USB Controller dùng đường dẫn tuyệt đối để đảm bảo chính xác */
    fragment@1 {
        target-path = "/soc@0/usb@32f10108/usb@38200000";
        __overlay__ {
            status = "okay";
            dr_mode = "otg";
            usb-role-switch;
            /* Buộc nó phải nhận node typec@47 làm switch */
            port {
                dwc3_0_endpoint: endpoint {
                    remote-endpoint = <&usb_con_endpoint>;
                };
            };
        };
    };
};
