/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/usb/pd.h>

/ {
    compatible = "toradex,verdin-imx8mp";

    /* Cấu hình chip HD3SS3220 trên bus I2C4 */
    fragment@0 {
        target = <&i2c4>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";

            typec@47 {
                compatible = "ti,hd3ss3220";
                reg = <0x47>;
                status = "okay";

                connector {
                    compatible = "usb-c-connector";
                    label = "USB-C-SS";
                    data-role = "dual";
                    power-role = "dual";
                    try-power-role = "sink";
                    /*
                     * Chú ý: Chúng ta không khai báo vbus-supply ở đây 
                     * để tránh lỗi NOTFOUND khi symbols bị thiếu. 
                     * Thay vào đó, ta sẽ dựa vào việc dwc3 core đã có vbus.
                     */
                    usb-role-switch;  
                    ports {
                        #address-cells = <1>;
                        #size-cells = <0>;
                        port@0 {
                            reg = <0>;
                            usb_con_endpoint: endpoint {
                                remote-endpoint = <&usb3_1_endpoint>;
                            };
                        };
                    };
                };
            };
        };
    };

    /* Cấu hình USB2 Controller */
    fragment@1 {
        target = <&usb3_1>;
        __overlay__ {
            status = "okay";
            usb-role-switch;

            /* Cấu hình trực tiếp dwc3 core bên trong để bẻ gãy dependency cycle */
            usb@38200000 {
                dr_mode = "otg";
                usb-role-switch;
                
                port {
                    usb3_1_endpoint: endpoint {
                        remote-endpoint = <&usb_con_endpoint>;
                    };
                };
            };
        };
    };
};
